# Database Connection (PostgreSQL / Neon)
# Local: postgresql://postgres:postgres@localhost:5432/scanflow
# Neon Production (Pooled): postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scanflow

# Better Auth Configuration
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your_32_character_random_secret_here
# Production: https://your-project.vercel.app | Local: http://localhost:3323
BETTER_AUTH_URL=http://localhost:3323

# Public Application URL (matches BETTER_AUTH_URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3323

